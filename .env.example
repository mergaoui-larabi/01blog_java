# Local development configuration sourced by the Makefile (`. ../../.env`).
# Untracked and outside the repository. Values recovered from the running services
# except INTERNAL_SERVICE_TOKEN, which is new: restart every service together.

# JWT RSA key location
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem

# This token is used to identify the origin of the request comming to the service without the gateway
INTERNAL_SERVICE_TOKEN=70fb1e6a2d115b286412827ddc45cdee1cc72e5e15635b78bed5f6e9b9b558b1

# services
## media-service
MEDIA_DB_HOST=postgres-media:5432
MEDIA_DB_NAME=blog_medias
MEDIA_DB_PASSWORD=secret
MEDIA_DB_USERNAME=blog_media
MEDIA_STORAGE_LOCATION=./media-storage
## moderation-service
MOD_DB_HOST=postgres-moderation:5432
MOD_DB_NAME=blog_moderations
MOD_DB_PASSWORD=secret
MOD_DB_USERNAME=blog_moderation
## notification-service
NOTIF_DB_HOST=postgres-notifications:5432
NOTIF_DB_NAME=blog_notifications
NOTIF_DB_PASSWORD=secret
NOTIF_DB_USERNAME=blog_notification
## post-service
POST_DB_HOST=postgres-posts:5432
POST_DB_NAME=blog_post
POST_DB_PASSWORD=secret
POST_DB_USERNAME=blog_post
## user-service
USER_DB_HOST=postgres-users:5432
USER_DB_NAME=blog_users
USER_DB_PASSWORD=secret
USER_DB_USERNAME=blog_user

## Docker's internal DNS containers IPS
POSTGRES_USERS_SERVICE_URL=postgres-users
POSTGRES_MEDIA_SERVICE_URL=postgres-media
POSTGRES_POSTS_SERVICE_URL=postgres-posts
POSTGRES_NOTIFICATIONS_SERVICE_URL=postgres-notifications
POSTGRES_MODERATION_SERVICE_URL=postgres-moderation

REDIS_SERVICE_URL=redis

API_GATEWAY_SERVICE_URL=http://api-gateway:5000
USER_SERVICE_URL=http://user-service:5001
AUTH_SERVICE_URL=http://auth-service:5002
MEDIA_SERVICE_URL=http://media-service:5003
POST_SERVICE_URL=http://post-service:5004
NOTIFICATION_SERVICE_URL=http://notification-service:5005
MODERATION_SERVICE_URL=http://moderation-service:5006
FRONTEND_SERVICE_URL=http://frontend:80

# Redis
REDIS_PASSWORD=secret

# ADMIN
INITIAL_ADMIN_ENABLED=true
INITIAL_ADMIN_EMAIL=admin@01blog.local
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=Password123!
INITIAL_ADMIN_AGE=25
INITIAL_ADMIN_GENDER=MALE