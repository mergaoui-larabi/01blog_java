# Local development configuration for the blog microservices.
#
#   cp .env.example .env      # at the repository root, then fill in the marked secrets
#   make start
#
# The Makefile sources this file itself — every `dev-*-service` target runs
# `cd backend/<service> && . ../../.env` and every `docker-*` target runs `cd docker && . ../.env` —
# so the real file must sit next to this example at the repository root. It is git-ignored there
# (`.gitignore`: `.env`), and `backend/*/.gitignore` also ignores a per-service copy.
#
# The frontend reads nothing from here: Angular URLs are compiled from
# frontend/blog/src/environments/environments.ts, including the gateway on :5000 and the notification
# WebSocket on ws://localhost:5005/ws/notifications (Notification Service directly, no gateway route).
#
# Keep these names in sync with docker/docker-compose.yml: the same variables create the PostgreSQL
# roles/databases and set the Redis password. Changing a password here does NOT change an existing
# volume — recreate with `make docker-clean-up` or run ALTER ROLE inside the container.

# --------------------------------------------------------------------------------------------------
# Service-to-service secret
# --------------------------------------------------------------------------------------------------
# Sent as X-Internal-Token on every call to /internal/** (user, post, notification and moderation
# services). All services must be running the same value, so restart them together after changing it.
# This must not be empty: the filter fails closed, and an unset token rejects every internal call
# including the login flow (auth-service -> user-service).
# Generate: openssl rand -hex 32
INTERNAL_SERVICE_TOKEN=replace-me-with-openssl-rand-hex-32

# --------------------------------------------------------------------------------------------------
# Auth Service RSA key pair (git-ignored by backend/auth-service/.gitignore; must be created locally)
# --------------------------------------------------------------------------------------------------
# Paths are resolved against the working directory the Makefile starts the service in, i.e.
# backend/auth-service. JwtKeyConfig expects a PKCS#8 private key and a SubjectPublicKeyInfo public key:
#
#   mkdir -p backend/auth-service/keys
#   cd backend/auth-service/keys
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
#
# The other services do not need these files; they fetch keys from http://localhost:5002/.well-known/jwks.json.
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem

# --------------------------------------------------------------------------------------------------
# Databases: one PostgreSQL 17 container per service (host ports from docker-compose.yml)
# --------------------------------------------------------------------------------------------------
USER_DB_HOST=localhost:5432
USER_DB_NAME=blog_users
USER_DB_USERNAME=blog_user
USER_DB_PASSWORD=replace-me

MEDIA_DB_HOST=localhost:5433
MEDIA_DB_NAME=blog_medias
MEDIA_DB_USERNAME=blog_media
MEDIA_DB_PASSWORD=replace-me

POST_DB_HOST=localhost:5434
POST_DB_NAME=blog_post
POST_DB_USERNAME=blog_post
POST_DB_PASSWORD=replace-me

NOTIF_DB_HOST=localhost:5435
NOTIF_DB_NAME=blog_notifications
NOTIF_DB_USERNAME=blog_notification
NOTIF_DB_PASSWORD=replace-me

MOD_DB_HOST=localhost:5436
MOD_DB_NAME=blog_moderations
MOD_DB_USERNAME=blog_moderation
MOD_DB_PASSWORD=replace-me

# --------------------------------------------------------------------------------------------------
# Redis: compose sets --requirepass, api-gateway uses it for its rate limiter
# --------------------------------------------------------------------------------------------------
REDIS_PASSWORD=replace-me

# --------------------------------------------------------------------------------------------------
# Media Service uploads
# --------------------------------------------------------------------------------------------------
# Resolved against backend/media-service, so this directory must exist before the first upload:
#   mkdir -p backend/media-service/media-storage
MEDIA_STORAGE_LOCATION=./media-storage

# --------------------------------------------------------------------------------------------------
# Inter-service base URLs — optional. Each one already defaults to the localhost port below, so leave
# them out unless a service runs somewhere else.
# --------------------------------------------------------------------------------------------------
# USER_SERVICE_URL=http://localhost:5001
# MEDIA_SERVICE_URL=http://localhost:5003
# POST_SERVICE_URL=http://localhost:5004
# NOTIFICATION_SERVICE_URL=http://localhost:5005
# MODERATION_SERVICE_URL=http://localhost:5006
